#!/usr/bin/env python3
"""Small auditable browser helper for terminal and optional graphical modes."""

from __future__ import annotations

import argparse
from datetime import datetime, timezone
from html.parser import HTMLParser
from pathlib import Path
import re
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request


class TextExtractor(HTMLParser):
    def __init__(self) -> None:
        super().__init__()
        self.parts: list[str] = []
        self.skip = 0

    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
        if tag in {"script", "style", "noscript"}:
            self.skip += 1

    def handle_endtag(self, tag: str) -> None:
        if tag in {"script", "style", "noscript"} and self.skip:
            self.skip -= 1

    def handle_data(self, data: str) -> None:
        if not self.skip and data.strip():
            self.parts.append(data.strip())


def main() -> int:
    parser = argparse.ArgumentParser(description="Fetch a page as text or open it in the optional GUI")
    parser.add_argument("url")
    parser.add_argument("--gui", action="store_true", help="open with the installed graphical browser")
    parser.add_argument("--max-bytes", type=int, default=2_000_000)
    args = parser.parse_args()
    parsed = urllib.parse.urlparse(args.url)
    if parsed.scheme not in {"http", "https"} or not parsed.netloc:
        parser.error("URL must use http or https")

    state = Path("/var/lib/micro-ubuntu/browser")
    state.mkdir(parents=True, exist_ok=True)
    with (state / "history.log").open("a", encoding="utf-8") as history:
        history.write(f"{datetime.now(timezone.utc).isoformat()}\t{args.url}\n")

    if args.gui:
        try:
            return subprocess.run(["xdg-open", args.url], check=False).returncode
        except FileNotFoundError:
            print("No graphical browser is installed. Run gui-builder first.", file=sys.stderr)
            return 1

    request = urllib.request.Request(args.url, headers={"User-Agent": "MicroUbuntu-Browser-Agent/1"})
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            body = response.read(max(1, args.max_bytes))
            content_type = response.headers.get_content_type()
            charset = response.headers.get_content_charset() or "utf-8"
    except (urllib.error.URLError, TimeoutError) as error:
        print(f"Fetch failed: {error}", file=sys.stderr)
        return 1
    text = body.decode(charset, errors="replace")
    if content_type == "text/html":
        extractor = TextExtractor()
        extractor.feed(text)
        text = "\n".join(extractor.parts)
    print(re.sub(r"[ \t]+", " ", text))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
