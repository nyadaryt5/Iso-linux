# MicroUbuntu build defaults. Every value may be overridden in the environment.
: "${UBUNTU_SUITE:=jammy}"
: "${UBUNTU_MIRROR:=http://archive.ubuntu.com/ubuntu}"
: "${UBUNTU_SECURITY_MIRROR:=http://security.ubuntu.com/ubuntu}"
: "${IMAGE_SIZE_MIB:=6144}"
: "${IMAGE_NAME:=micro-ubuntu-full.img}"
: "${IMAGE_GZIP_NAME:=micro-ubuntu-full.img.gz}"
: "${COMPACT_ISO_NAME:=micro-ubuntu-bootstrap.iso}"
: "${WIFI_ISO_NAME:=micro-ubuntu-wifi-installer.iso}"
: "${COMPACT_ISO_MAX_MIB:=32}"

# The compact installer never asks for an arbitrary URL. IMAGE_URL is embedded
# at build time and must be an HTTPS URL without an OWNER/REPOSITORY placeholder.
# GitHub Actions computes the repository-specific URL automatically.
: "${IMAGE_URL:=}"
